{
  "name": "@bun-mono/auth",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "check-types": "tsgo --build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@bun-mono/db": "workspace:*",
    "@bun-mono/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bun-mono/config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "tsdown": "catalog:"
  }
}
