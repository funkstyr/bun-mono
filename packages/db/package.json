{
  "name": "@bun-mono/db",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "check-types": "tsgo --build",
    "db:local": "turso dev --db-file local.db",
    "db:init": "bun scripts/init.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bun-mono/env": "workspace:*",
    "@libsql/client": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "libsql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bun-mono/config": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "^0.31.10",
    "tsdown": "catalog:"
  }
}
