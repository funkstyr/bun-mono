{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/test/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/e2e/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/drizzle/migrations/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "env": {
    "builtin": true
  }
}
