# Copy to apps/server/.env, then run `bun db:init` to create the SQLite file
# and apply migrations.

# Local libsql/SQLite file. Resolved relative to `apps/server/` (where this
# .env lives and where the dev server runs from). `bun db:init` creates this
# file and applies the schema. To point at a remote Turso instance, use the
# libsql:// URL Turso gives you and set TURSO_AUTH_TOKEN.
DATABASE_URL=file:local.db

# better-auth shared secret. Must be at least 32 characters. Generate a
# random one for local dev — never share or reuse the prod value.
BETTER_AUTH_SECRET=dev-only-please-replace-with-32-or-more-chars

# Public URL the auth server serves from (used to build email links etc.).
BETTER_AUTH_URL=http://localhost:3000

# Origin allowed for browser CORS (the web app's URL).
CORS_ORIGIN=http://localhost:3001

# development | production | test. Leave as `development` locally.
NODE_ENV=development
