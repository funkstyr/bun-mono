{
  "extends": "@bun-mono/config/tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "test-bun/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
