{
  "extends": "@bun-mono/config/tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["dist", "node_modules", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
