{
  "permissions": {
    "allow": [
      "Bash(bun --filter *)",
      "Bash(bun build *)",
      "Bash(bun check)",
      "Bash(bun check-types *)",
      "Bash(bun install *)",
      "Bash(bun format *)",
      "Bash(bun format:fix *)",
      "Bash(bun lint *)",
      "Bash(bun test *)",
      "Bash(bun turbo *)",
      "Bash(bun run *)",
      "Skill(house-style)",
      "Bash(bunx vitest *)",
      "Bash(bun pm *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "mcp__cclsp__find_definition",
      "mcp__cclsp__find_references",
      "mcp__cclsp__get_diagnostics",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(gh label *)",
      "Bash(gh issue *)",
      "Bash(gh project *)",
      "Bash(git checkout *)",
      "Skill(pr-review)",
      "Bash(gh pr *)",
      "Bash(bun fix *)",
      "Bash(bunx playwright *)",
      "Bash(bun e2e *)"
    ],
    "deny": [
      "Read(**/.turbo/**)",
      "Read(**/coverage/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)",
      "Read(**/.next/**)",
      "Read(**/.vite/**)",
      "Read(**/.tanstack/**)",
      "Read(**/bun.lock)",
      "Read(**/*.tsbuildinfo)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-fix-and-check.sh"
          }
        ]
      }
    ]
  }
}
