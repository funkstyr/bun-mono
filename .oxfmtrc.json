{
  "sortImports": {
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**", "react-dom", "react-dom/**"]
      },
      { "groupName": "workspace", "elementNamePattern": ["@bun-mono/**"] }
    ],
    "groups": [
      "side_effect",
      "react",
      { "newlinesBetween": false },
      ["builtin", "external"],
      "workspace",
      { "newlinesBetween": false },
      ["internal", "subpath"],
      "style",
      { "newlinesBetween": false },
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "internalPattern": ["~/", "@/"],
    "newlinesBetween": true
  },
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": ["**/routeTree.gen.ts", "turbo/generators/templates/**"]
}
