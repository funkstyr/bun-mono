{
  "sortImports": {
    "groups": [
      "side_effect",
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@bun-mono/**", "~/**", "@/**"],
    "newlinesBetween": true
  },
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": ["**/routeTree.gen.ts"]
}
