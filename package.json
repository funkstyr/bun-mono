{
  "name": "bun-mono",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@typescript/native-preview": "7.0.0-dev.20260515.1",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.19",
      "@orpc/server": "^1.14.3",
      "@orpc/openapi": "^1.14.3",
      "@orpc/zod": "^1.14.3",
      "better-auth": "^1.6.11",
      "react": "^19.2.6",
      "ai": "^6.0.185",
      "effect": "^3.21.2",
      "@effect/schema": "^0.75.5",
      "@effect/platform": "^0.96.1",
      "arktype": "^2.2.0",
      "@types/react": "^19.2.14",
      "@effect/vitest": "^0.29.0",
      "vitest": "^4.1.6",
      "@vitest/ui": "^4.1.6",
      "@vitest/coverage-v8": "^4.1.6",
      "jsdom": "^29.1.1",
      "@playwright/test": "^1.60.0",
      "playwright": "^1.60.0",
      "@libsql/client": "^0.17.3",
      "libsql": "^0.5.29",
      "@orpc/client": "^1.14.3",
      "tsdown": "^0.22.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run build:packages && turbo dev",
    "dev:native": "bun run build:packages && turbo -F native dev",
    "dev:web": "bun run build:packages && turbo -F web dev",
    "dev:server": "bun run build:packages && turbo -F server dev",
    "build": "turbo build",
    "build:packages": "turbo build --filter=\"./packages/*\"",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "check": "bun lint && bun format && bun check-types && bun run test && bun run build",
    "fix": "bun lint:fix && bun format:fix",
    "db:push": "turbo -F @bun-mono/db db:push",
    "db:studio": "turbo -F @bun-mono/db db:studio",
    "db:generate": "turbo -F @bun-mono/db db:generate",
    "db:migrate": "turbo -F @bun-mono/db db:migrate",
    "db:local": "turbo -F @bun-mono/db db:local",
    "postinstall": "lefthook install",
    "up-deps": "bunx taze -r -w minor",
    "up-deps:major": "bunx taze -r -w major"
  },
  "dependencies": {
    "@bun-mono/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bun-mono/config": "workspace:*",
    "@turbo/gen": "^2.9.14",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
